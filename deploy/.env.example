# PRODUCTION environment for deploy/docker-compose.prod.yml.
# On the VM:  cp deploy/.env.example deploy/.env  and fill in strong values.
# deploy/.env is gitignored — NEVER commit the real file.
#
# Generate secrets:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# The backend REFUSES to start (FOXY_ENV=prod fail-fast) if the two session
# secrets are weak, missing, or equal, or if the pepper is empty.

POSTGRES_PASSWORD=change-me-strong
SESSION_SECRET=change-me-strong
STAFF_SESSION_SECRET=change-me-DIFFERENT-strong
# Set once, keep stable — changing it invalidates all peppered API keys.
API_KEY_PEPPER=change-me-strong

# Cookie / CORS wiring for the three subdomains (defaults match foxyaudit.tech).
STAFF_COOKIE_DOMAIN=admin.foxyaudit.tech
CORS_ORIGINS=https://foxyaudit.tech,https://www.foxyaudit.tech
ADMIN_CORS_ORIGINS=
# Comma-separated office/VPN egress IPs; empty = allow all (auth still required).
ADMIN_IP_ALLOWLIST=

# Telemetry / rollups
TRAFFIC_TRACKING_ENABLED=true
TRAFFIC_RETENTION_DAYS=90
USAGE_ROLLUP_INTERVAL=300

# AI judge + billing (blank = disabled). New Google accounts get AQ.-prefixed
# keys and can NOT use the retired gemini-1.5-pro — gemini-2.5-flash (the
# default here) is the current free-tier model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Checkout price IDs per paid plan (self-serve onboarding). Empty = that
# plan's buy button returns 422 until you paste the price_… ID from Stripe.
STRIPE_PRICE_COMPANION=
STRIPE_PRICE_GUARDIAN=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Google SSO — "Continue with Google" on the dashboard + sales page. Paste the
# OAuth 2.0 Web Client ID (public) from Google Cloud → APIs & Services →
# Credentials. Add authorized JS origins https://app.foxyaudit.tech and
# https://foxyaudit.tech. Blank = the Google button is hidden (feature off).
GOOGLE_OAUTH_CLIENT_ID=

# Transactional email — Brevo (sends MFA sign-in codes; blank = logged no-op, no
# mail). Key from Brevo → SMTP & API → API Keys. The sender MUST be a verified
# sender/domain in Brevo or every send bounces.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@foxyaudit.tech
BREVO_SENDER_NAME=Foxy Audit

# Password-reset + invite link base URLs (where the login pages load). Defaults
# match foxyaudit.tech; override only for a different host.
DASHBOARD_URL=https://app.foxyaudit.tech/dashboard
ADMIN_URL=https://admin.foxyaudit.tech/admin/

# Ops alerting + retention (5D/5E). ALERT_EMAIL blank = log-only (no dead-letter
# grading email). The retention/breaker defaults are sensible — override rarely.
ALERT_EMAIL=
ADMIN_ACTIONS_RETENTION_DAYS=365
GRADING_BREAKER_THRESHOLD=3
GRADING_BREAKER_COOLDOWN=60
GRADING_MAX_BACKOFF=60

# Public-chain anchoring (flip to evm + fill the EVM vars to anchor on Sepolia)
ANCHOR_ENABLED=false
ANCHOR_PROVIDER=stub
ANCHOR_INTERVAL_SECONDS=3600
# Per-tier automatic-anchor cadence in seconds (6E). Manual "anchor now" is never
# gated. Sub-hour cadences also need a smaller ANCHOR_INTERVAL_SECONDS (the sweep).
ANCHOR_CADENCE_FREE=86400
ANCHOR_CADENCE_PRO=21600
ANCHOR_CADENCE_MAX=3600
ANCHOR_CADENCE_ENTERPRISE=3600
ANCHOR_CADENCE_DEFAULT=86400
ANCHOR_EVM_RPC_URL=
ANCHOR_EVM_CHAIN=sepolia
ANCHOR_EVM_PRIVATE_KEY=
ANCHOR_EVM_CONTRACT=
# Safety rails (7C). Refuse to anchor below this wallet balance in wei (0 = off;
# e.g. 10000000000000000 = 0.01 ETH). Alert (needs ALERT_EMAIL) when the newest
# confirmed anchor is older than ANCHOR_STALE_ALERT_SECONDS (0 = off) or an org's
# latest anchor is 'failed', at most once per ANCHOR_ALERT_COOLDOWN seconds.
ANCHOR_WALLET_MIN_BALANCE_WEI=0
ANCHOR_STALE_ALERT_SECONDS=0
ANCHOR_ALERT_COOLDOWN=3600
