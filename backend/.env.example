# Copy to backend/.env (gitignored) for local dev, or set these in your platform's
# secret store for a real deploy. NEVER commit real secrets.

# ── Deployment ──────────────────────────────────────────────────────────────
# "dev" keeps insecure defaults usable locally. Set FOXY_ENV=prod in production:
# the app then FAILS TO START unless SESSION_SECRET and API_KEY_PEPPER are set to
# strong non-default values (see config.py's _require_secure_prod validator).
FOXY_ENV=dev

DATABASE_URL=postgresql+psycopg://foxy:foxy@localhost:5432/foxy

# ── Secrets (REQUIRED in prod) ──────────────────────────────────────────────
# Generate strong random values, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# SESSION_SECRET signs the human dashboard's login cookie.
SESSION_SECRET=dev-insecure-session-secret-change-me
# API_KEY_PEPPER is mixed into the API-key HMAC (a DB leak alone can't recover keys).
# CHANGING IT INVALIDATES ALL EXISTING PEPPERED KEYS — set it once, keep it stable.
API_KEY_PEPPER=

# CORS allow-list (comma-separated origins). A literal "*" is always stripped.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin site ("site 3") + staff sessions (Phase 4 #1) ─────────────────────
# STAFF_SESSION_SECRET signs the staff cookie (foxy_staff_session). REQUIRED in
# prod and MUST DIFFER from SESSION_SECRET (enforced at startup) — a shared
# secret would let one channel's cookie be forged into the other.
STAFF_SESSION_SECRET=dev-insecure-staff-session-secret-change-me
# Scope the staff cookie to the admin host only (e.g. admin.foxyaudit.com).
# Empty = host-only cookie (fine for localhost dev).
STAFF_COOKIE_DOMAIN=
# Admin-site CORS allow-list — kept SEPARATE from CORS_ORIGINS so the admin
# origin is never accepted on the customer /v1 API (and vice-versa).
ADMIN_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional comma-separated IP allow-list for /admin/* (403s everything else,
# before auth). Empty = allow all (dev); in prod restrict to office/VPN IPs.
ADMIN_IP_ALLOWLIST=

# ── Traffic capture + usage rollups (Phase 4 #1) ────────────────────────────
# Per-request in/out telemetry → the partitioned traffic_events table. IP and
# user-agent are HMAC-hashed with API_KEY_PEPPER (never stored raw); writes
# happen off the request hot path and never break a request.
TRAFFIC_TRACKING_ENABLED=true
# Monthly traffic_events partitions older than this are DROPped by the worker.
TRAFFIC_RETENTION_DAYS=90
# Seconds between usage_daily rollup passes (worker thread, app/usage.py).
USAGE_ROLLUP_INTERVAL=300

# ── AI judge (Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# true = flag (not pass) interactions when the judge is unreachable.
GEMINI_FAIL_CLOSED=false

# ── Stripe billing (optional — blank disables the webhook) ──────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Durable grading queue (Postgres outbox poller) — defaults are fine ──────
GRADING_POLL_INTERVAL=2.0
GRADING_BATCH_SIZE=16
GRADING_MAX_ATTEMPTS=5
GRADING_STUCK_SECONDS=300

# ── Public-chain anchoring (Phase 3 A1) ─────────────────────────────────────
# 'stub' = deterministic, no chain (dev/CI). Flip to 'evm' for Sepolia (see
# contracts/README.md). No code change — just these vars + restart the worker.
ANCHOR_ENABLED=false
ANCHOR_PROVIDER=stub
ANCHOR_INTERVAL_SECONDS=3600
ANCHOR_EVM_RPC_URL=
ANCHOR_EVM_CHAIN=sepolia
ANCHOR_EVM_PRIVATE_KEY=
ANCHOR_EVM_CONTRACT=
