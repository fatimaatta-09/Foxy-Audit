# Copy to backend/.env and fill in GEMINI_API_KEY.
DATABASE_URL=postgresql+psycopg://foxy:foxy@localhost:5432/foxy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# Set to true to flag (instead of pass) interactions when the judge is unreachable.
GEMINI_FAIL_CLOSED=false
# Stripe billing (optional — leave blank to disable the webhook endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Durable grading queue (Postgres outbox poller — app/worker.py). Defaults are fine.
GRADING_POLL_INTERVAL=2.0
GRADING_BATCH_SIZE=16
GRADING_MAX_ATTEMPTS=5
GRADING_STUCK_SECONDS=300
